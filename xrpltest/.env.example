# Xaman developer app credentials for Connect Wallet and Pay with Xaman.
# Obtain from https://apps.xumm.dev — these are app credentials, NOT wallet seeds.
XAMAN_API_KEY=
XAMAN_API_SECRET=

# Optional vendor payments only. Attendee ticket checkout needs no signing seed.
# Use a dedicated funded TESTNET wallet, never a Mainnet wallet.
XRPL_TESTNET_SEED=
