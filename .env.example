ANCHOR_API_KEY=
# HTTP(S) instance origin, without /rpc or /sql.
SURREAL_URL=http://127.0.0.1:8000
SURREAL_NS=outreach
SURREAL_DB=outreach
SURREAL_USER=root
SURREAL_PASS=
# Alternatively provide a database token instead of basic credentials.
SURREAL_TOKEN=

# Spectron / SurrealDB Agent Memory for agent-fetched and manually captured text.
# When configured, document_store prefers this backend over direct SurrealDB.
SPECTRON_URL=
SPECTRON_CONTEXT_ID=
SPECTRON_API_KEY=

# Optional Daytona / OpenCode runtime (requirements-agent.txt)
DAYTONA_API_KEY=
DAYTONA_TARGET=us
# Optional existing snapshot containing npm, Python 3, curl and git.
DAYTONA_SNAPSHOT=
# Select a model available to your provider/account: provider/model
OPENCODE_MODEL=
AGENT_TRACING=off
# AWS Bedrock: either access keys (+ optional session token) or a Bedrock bearer token.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=
# Alternative OpenCode provider credentials (only configured values are forwarded).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Arize AX tracing: use AGENT_TRACING=arize and supply both credentials.
ARIZE_API_KEY=
ARIZE_SPACE_ID=
ARIZE_PROJECT_NAME=nyc-nonprofit-operator
# Phoenix tracing: use AGENT_TRACING=phoenix and an endpoint reachable FROM the sandbox.
PHOENIX_ENDPOINT=
PHOENIX_API_KEY=
PHOENIX_PROJECT=nyc-nonprofit-operator

# XRPL: disposable Testnet wallets only; run python -m operator_app.payments --setup
XRPL_ENABLED=false
XRPL_WALLET_FILE=.xrpl-wallets.json
XRPL_DB_PATH=.xrpl-payments.sqlite3
XRPL_EVENT_BUDGET_XRP=100
